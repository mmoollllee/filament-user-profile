{
    "name": "mmoollllee/filament-user-profile",
    "description": "Profile photos and a profile page for Filament v5: private photos behind an authorised route, a circle-cropped upload field, initials avatars rendered locally instead of by a third-party service, and a tabbed profile page applications extend with their own fields.",
    "keywords": [
        "laravel",
        "filament",
        "filamentphp",
        "profile",
        "profile-photo",
        "avatar",
        "livewire"
    ],
    "homepage": "https://github.com/mmoollllee/filament-user-profile",
    "license": "MIT",
    "authors": [
        {
            "name": "Moritz Graf",
            "email": "info@moritz-graf.de",
            "homepage": "https://moritz-graf.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^11.28|^12.0|^13.0",
        "illuminate/database": "^11.28|^12.0|^13.0",
        "illuminate/support": "^11.28|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Mmoollllee\\FilamentUserProfile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mmoollllee\\FilamentUserProfile\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mmoollllee\\FilamentUserProfile\\UserProfileServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
